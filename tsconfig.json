{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [".astro/types.d.ts", "src/**/*", "pipeline/**/*", "tests/**/*"],
  "exclude": ["dist", "node_modules", ".cache"]
}
