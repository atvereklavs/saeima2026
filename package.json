{
  "name": "saeima2026",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Latvian 15th Saeima election (3 Oct 2026): lists and candidates by experience, strengths and history in government",
  "license": "MIT",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test 'tests/**/*.test.ts'",
    "pipeline:cvk": "node pipeline/fetch-cvk.ts",
    "pipeline:build": "node pipeline/build-dataset.ts",
    "pipeline:all": "node pipeline/fetch-cvk.ts && node pipeline/build-dataset.ts",
    "deploy:dry": "astro build && wrangler deploy --dry-run",
    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/react": "6.0.5",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "cheerio": "1.2.0",
    "typescript": "~5.9.3",
    "wrangler": "4.129.1"
  }
}
